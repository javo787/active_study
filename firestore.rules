rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check user roles
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isTeacher() {
      return request.auth != null && getUserRole() == 'teacher';
    }

    function isStudent() {
      return request.auth != null && getUserRole() == 'student';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      // Allow users to create their own document (for initial sign-in)
      // Only admins can modify the role field, otherwise users can modify their own doc
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.role == 'student';
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if request.auth != null; // Anyone can read exams (students see published ones only, checked in frontend, but could add rules if needed)
      allow write: if isAdmin() || isTeacher();

      match /variants/{variantId} {
        allow read: if request.auth != null;
        allow write: if isAdmin() || isTeacher();

        match /questions/{questionId} {
          allow read: if request.auth != null;
          allow write: if isAdmin() || isTeacher();
        }
      }
    }

    match /attempts/{attemptId} {
      allow read: if request.auth != null;
      // Users can create their own attempts, or admins/teachers can create preview attempts
      allow create: if request.auth != null;
      // Users can update their own attempts, admins/teachers can update any attempt
      allow update: if request.auth != null && (request.resource.data.studentId == request.auth.uid || isAdmin() || isTeacher());
      allow delete: if isAdmin();
    }
  }
}
